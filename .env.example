# Copy to .env and fill in. .env is gitignored; this template is committed.

# ---- LLM API (generator / judge-model baseline) ----
ANTHROPIC_API_KEY=
# Optional fallbacks if you compare providers
OPENAI_API_KEY=

# ---- Hugging Face (MedCPT, rerankers, NLI/MiniCheck verifiers) ----
HF_TOKEN=
HF_HOME=./.cache/hf

# ---- NCBI E-utilities (PubMed retrieval; higher rate limits with a key) ----
NCBI_API_KEY=
NCBI_EMAIL=

# ---- Paths (kept out of git; see .gitignore) ----
DATA_DIR=./data
INDEX_DIR=./indexes
MODEL_DIR=./models
OUTPUT_DIR=./outputs

# ---- Experiment tracking (optional) ----
WANDB_API_KEY=
WANDB_PROJECT=biomedical-attribution-rag
WANDB_MODE=online
