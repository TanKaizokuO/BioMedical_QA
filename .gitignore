# ---- ML / data artifacts (biomedical RAG) ----
# Datasets & corpora (PubMed, PubMedQA, BioASQ, etc.) — track via download scripts, not git.
# data/* rather than data/ — git will not descend into an excluded directory, so the negations
# below only work if the exclusion is on the contents (the same reason docs/* is written that way).
data/*
# Tracked exceptions: the small identity artifacts whose hashes go into every run manifest. These
# are membership lists, not data — splits.json is the frozen dev/test split (§3 requires it checked
# in), and gold_pmids.json is the dedup key set (ADR-0012 §1).
!data/splits.json
!data/gold_pmids.json
datasets/
corpus/
*.jsonl
*.parquet
*.arrow
*.csv
*.tsv

# Retrieval indexes & embeddings (BM25 / dense / FAISS)
indexes/
index/
*.faiss
*.index
*.bin
embeddings/
*.npy
*.npz
*.pkl
*.pickle

# Model checkpoints & weights (MedCPT, rerankers, NLI verifiers)
models/
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.gguf
.cache/
hf_cache/
transformers_cache/

# Experiment outputs / runs / logs
outputs/
results/
runs/
logs/
*.log
wandb/
mlruns/
lightning_logs/
tensorboard/

# ---- Editors / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude Code (keep shared project config, ignore local overrides) ----
.claude/settings.local.json

# ---- Planning / research notes (local, not tracked) ----
# docs/* rather than docs/ — git will not descend into an excluded directory, so the
# negations below only work if the exclusion is on the contents, not the directory itself.
docs/*
# Tracked exceptions: decision records, and the frozen reference material harvested from
# the retired base pipeline (ADR-0007) — the source repo may be deleted, so this is the backup.
!docs/adr/
!docs/harvest/

# ---- Teaching workspace (/teach skill — local study materials, not tracked) ----
teach/
